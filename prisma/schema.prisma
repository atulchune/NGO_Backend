generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ADMIN AUTHENTICATION
// ==========================================
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed password
  name      String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

// ==========================================
// DYNAMIC LANDING PAGE CONTENT
// ==========================================

// 1. Hero Section Management
model HeroSection {
  id          String   @id @default(uuid())
  title       String   // e.g., "Welcome to our NGO"
  subtitle    String   // e.g., "Helping the community"
  imageUrl    String?  // Background image
  ctaText     String?  // e.g., "Donate Now"
  ctaLink     String?
  isActive    Boolean  @default(true) // Only one should be active at a time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 2. Daily Hukamnama
model Hukamnama {
  id          String   @id @default(uuid())
  date        DateTime @unique // One per day
  ang         Int?     // Page number in SGGS
  gurmukhi    String   @db.Text
  translation String   @db.Text // English or local language
  audioUrl    String?  // Link to audio pronunciation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 3. Upcoming Events
model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  eventDate   DateTime
  location    String
  imageUrl    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 4. Latest Updates / Blog / News
model Update {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  imageUrl    String?
  author      String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 5. Testimonials
model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String?  // e.g., "Volunteer"
  quote       String   @db.Text
  avatarUrl   String?
  isApproved  Boolean  @default(false) // Admin must approve before showing on web
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 6. Publications / Books / Resources
model Publication {
  id          String   @id @default(uuid())
  title       String
  author      String?
  description String   @db.Text
  coverImage  String?
  pdfUrl      String   // Link to download the resource
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContentType {
  NEWS
  BLOG
  EVENT
  PROJECT
}

enum MediaType {
  VIDEO
  AUDIO
}

enum MediaCategory {
  LIVE_KIRTAN
  DAILY_MUKHWAK
  MUKHWAK_KATHA
}

enum MediaSource {
  UPLOAD
  YOUTUBE
  LIVE_STREAM
}

model Content {
  id          String      @id @default(uuid())
  type        ContentType 
  title       String
  content     String      @db.Text
  image       String      // Stores the S3 URL of the uploaded image
  
  // Type-specific nullable fields
  category    String?     // e.g., "Health", "Education" (For NEWS)
  author      String?     // For BLOG
  status      String?     // e.g., "Active", "Completed" (For PROJECT)
  
  // Event specific
  eventDate   DateTime?
  eventTime   String?
  venue       String?
  
  showInMarquee Boolean   @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([type]) // Index for fast filtering on the web portal
}

model Media {
  id          String      @id @default(uuid())
  type        MediaType   
  category    MediaCategory?
  title       String
  sourceType  MediaSource 
  url         String      // S3 URL or YouTube link
  isLive      Boolean     @default(false)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([type, isLive]) // Index for fast retrieval of Live events
}
